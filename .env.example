DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

POSTGRES_DB=ai_code_reviewer
POSTGRES_USER=ai_code_reviewer
POSTGRES_PASSWORD=ai_code_reviewer
# Use "localhost" when running Django directly on your machine, or "db" when
# running inside docker-compose (docker-compose.yml overrides this for you).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# Leave blank to use the mock reviewer (see reviews/services.py) instead of
# calling the real Gemini API.
GEMINI_API_KEY=

# How many submissions a single user can create per day, e.g. "20/day" or "5/hour".
SUBMISSION_THROTTLE_RATE=20/day
